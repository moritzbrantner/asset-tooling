{
  "schemaVersion": 1,
  "profile": "repository-foundation-v1",
  "tiers": {
    "fast": ["test", "package:check"],
    "standard": ["test:integration"]
  },
  "requiredCapabilities": ["test", "package:check", "test:integration"],
  "capabilityCommands": {
    ".": {
      "test": ["bun", "test"],
      "package:check": ["bun", "run", "package:check"],
      "test:integration": ["bun", "run", "stability:check"]
    }
  }
}
