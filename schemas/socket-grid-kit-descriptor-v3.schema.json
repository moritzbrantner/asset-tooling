{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moritzbrantner.github.io/asset-tooling/schemas/socket-grid-kit-descriptor-v3.schema.json",
  "title": "asset-tooling socket-grid part kit descriptor v3",
  "description": "v2 (socket-grid-kit-descriptor-v2, unchanged) plus what locomotion kits need (#634, docs/robot-locomotion.md): per part, an optional locomotion block (the axis wheels turn about, the rolling radius, the bodies the game turns and where, the visual wheel nodes, a track belt and how to drive the roll clip from a joint angle), and the top-level locomotionRule. Every value is in metres in the part's own glTF frame: +Y up, right-handed, the origin at the part's mount anchor. Sockets, joints, anchors, channels, states and locomotion are presentation metadata; the game owns part IDs, footprints, motion, contacts, damage, attachment legality and assembly.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kit",
    "units",
    "up",
    "handedness",
    "cell",
    "frame",
    "faces",
    "socketNumbering",
    "mounting",
    "lodSelection",
    "authority",
    "parts",
    "compositions"
  ],
  "properties": {
    "schema": {
      "const": "socket-grid-kit-descriptor-v3"
    },
    "kit": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "units": {
      "const": "metre"
    },
    "up": {
      "const": "+Y"
    },
    "handedness": {
      "const": "right"
    },
    "cell": {
      "type": "number"
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partAxes",
        "origin",
        "mountFace",
        "rule"
      ],
      "properties": {
        "partAxes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "const": "+X"
            },
            "y": {
              "const": "-Z"
            },
            "z": {
              "const": "+Y"
            }
          }
        },
        "origin": {
          "const": "mount-anchor"
        },
        "mountFace": {
          "const": "NegZ"
        },
        "rule": {
          "type": "string"
        }
      }
    },
    "faces": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "face",
          "normal",
          "uAxis",
          "vAxis"
        ],
        "properties": {
          "face": {
            "$ref": "#/$defs/face"
          },
          "normal": {
            "$ref": "#/$defs/vec3"
          },
          "uAxis": {
            "$ref": "#/$defs/vec3"
          },
          "vAxis": {
            "$ref": "#/$defs/vec3"
          }
        }
      }
    },
    "socketNumbering": {
      "type": "string"
    },
    "mounting": {
      "type": "string"
    },
    "lodSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "referenceFovYDegrees",
        "rule"
      ],
      "properties": {
        "metric": {
          "const": "projected-bounding-sphere-height-fraction"
        },
        "referenceFovYDegrees": {
          "type": "number"
        },
        "rule": {
          "type": "string"
        }
      }
    },
    "authority": {
      "type": "string"
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "compositions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/composition"
      }
    },
    "weaponAxes": {
      "type": "string"
    },
    "channelRule": {
      "type": "string"
    },
    "modMounting": {
      "type": "string"
    },
    "sources": {
      "type": "string"
    },
    "mods": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mod"
      }
    },
    "locomotionRule": {
      "type": "string"
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "quat": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "cells": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "integer"
      }
    },
    "face": {
      "enum": [
        "PosX",
        "NegX",
        "PosY",
        "NegY",
        "PosZ",
        "NegZ"
      ]
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "$ref": "#/$defs/vec3"
        },
        "max": {
          "$ref": "#/$defs/vec3"
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "normal",
        "uAxis",
        "vAxis"
      ],
      "properties": {
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "normal": {
          "$ref": "#/$defs/vec3"
        },
        "uAxis": {
          "$ref": "#/$defs/vec3"
        },
        "vAxis": {
          "$ref": "#/$defs/vec3"
        }
      }
    },
    "socket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "face",
        "u",
        "v",
        "position",
        "normal",
        "uAxis",
        "vAxis"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "face": {
          "$ref": "#/$defs/face"
        },
        "u": {
          "type": "integer"
        },
        "v": {
          "type": "integer"
        },
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "normal": {
          "$ref": "#/$defs/vec3"
        },
        "uAxis": {
          "$ref": "#/$defs/vec3"
        },
        "vAxis": {
          "$ref": "#/$defs/vec3"
        }
      }
    },
    "joint": {
      "description": "A motor axis Shooter drives (hinge, rotor, wheel, leg sub-joint): the node it turns, its origin and unit axis in the part frame, the sockets and nodes on its moving side, and its range in radians (absent for a continuous joint).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "origin",
        "axis"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z-]+$"
        },
        "node": {
          "type": "string"
        },
        "parent": {
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/vec3"
        },
        "axis": {
          "$ref": "#/$defs/vec3"
        },
        "movingSockets": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "anchor": {
      "description": "A named point with a direction that is not a socket, such as a muzzle, an emitter, a cable anchor, a blade edge or a mod mount (kind mod-mount, where a mod sits).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "position",
        "normal"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z-]+$"
        },
        "node": {
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "normal": {
          "$ref": "#/$defs/vec3"
        },
        "up": {
          "$ref": "#/$defs/vec3"
        }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "tag",
        "center",
        "size"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "tag": {
          "const": "hit-proxy"
        },
        "center": {
          "$ref": "#/$defs/vec3"
        },
        "size": {
          "$ref": "#/$defs/vec3"
        }
      }
    },
    "lods": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundingSphere",
        "levels"
      ],
      "properties": {
        "boundingSphere": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "center",
            "radius"
          ],
          "properties": {
            "center": {
              "$ref": "#/$defs/vec3"
            },
            "radius": {
              "type": "number"
            }
          }
        },
        "levels": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "variant",
              "triangles",
              "minScreenSize",
              "referenceMaxDistance"
            ],
            "properties": {
              "variant": {
                "type": "string"
              },
              "triangles": {
                "type": "integer"
              },
              "minScreenSize": {
                "type": "number"
              },
              "referenceMaxDistance": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "kind",
        "cells",
        "socketFaces",
        "cuboid",
        "bounds",
        "triangles",
        "mount",
        "socketCount",
        "sockets",
        "joints",
        "anchors",
        "hitProxies",
        "lods",
        "variants"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z]+(\\.[a-z0-9-]+)+$"
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z-]+$"
        },
        "cells": {
          "$ref": "#/$defs/cells"
        },
        "socketFaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/face"
          }
        },
        "cuboid": {
          "$ref": "#/$defs/box"
        },
        "bounds": {
          "$ref": "#/$defs/box"
        },
        "triangles": {
          "type": "integer"
        },
        "mount": {
          "$ref": "#/$defs/frame"
        },
        "socketCount": {
          "type": "integer"
        },
        "sockets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/socket"
          }
        },
        "joints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/joint"
          }
        },
        "anchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/anchor"
          }
        },
        "hitProxies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proxy"
          }
        },
        "lods": {
          "$ref": "#/$defs/lods"
        },
        "variants": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lods"
            ],
            "properties": {
              "lods": {
                "$ref": "#/$defs/lods"
              }
            }
          }
        },
        "channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/channel"
          }
        },
        "states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state"
          }
        },
        "locomotion": {
          "$ref": "#/$defs/locomotion"
        }
      }
    },
    "orientation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "yaw",
        "pitch",
        "roll"
      ],
      "properties": {
        "yaw": {
          "type": "integer"
        },
        "pitch": {
          "type": "integer"
        },
        "roll": {
          "type": "integer"
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "note",
        "items"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "key",
              "translation",
              "rotation"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "key": {
                "type": "string"
              },
              "variant": {
                "type": "string"
              },
              "placeholder": {
                "const": true
              },
              "cells": {
                "$ref": "#/$defs/cells"
              },
              "parent": {
                "type": "string"
              },
              "socket": {
                "type": "integer"
              },
              "face": {
                "$ref": "#/$defs/face"
              },
              "u": {
                "type": "integer"
              },
              "v": {
                "type": "integer"
              },
              "orientation": {
                "$ref": "#/$defs/orientation"
              },
              "translation": {
                "$ref": "#/$defs/vec3"
              },
              "rotation": {
                "$ref": "#/$defs/quat"
              },
              "kit": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "mod": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "key",
                  "anchor",
                  "translation",
                  "rotation"
                ],
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "anchor": {
                    "type": "string"
                  },
                  "translation": {
                    "$ref": "#/$defs/vec3"
                  },
                  "rotation": {
                    "$ref": "#/$defs/quat"
                  }
                }
              }
            }
          }
        }
      }
    },
    "channel": {
      "description": "An emissive channel: the glow geometry skinned to `node`; the node's scale is the channel's level (1 lit as modelled, 0 hidden in its housing, above 1 a flash).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "node",
        "kind",
        "colour",
        "meaning"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z-]+$"
        },
        "node": {
          "type": "string"
        },
        "kind": {
          "const": "emissive"
        },
        "colour": {
          "$ref": "#/$defs/vec3"
        },
        "meaning": {
          "type": "string"
        }
      }
    },
    "state": {
      "description": "A visual state: the glTF animation that plays it, whether it loops, its length in seconds, what the game uses it for and the nodes it moves.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "animation",
        "loop",
        "seconds",
        "use",
        "nodes"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "animation": {
          "type": "string"
        },
        "loop": {
          "type": "boolean"
        },
        "seconds": {
          "type": "number"
        },
        "use": {
          "type": "string",
          "pattern": "^[a-z-]+$"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "mod": {
      "description": "A mod: a small static add-on with no cells, which sits on a weapon anchor of kind mod-mount named `mountsOn` (its origin on the anchor, its +Y along the anchor normal, its -Z along the anchor up). `fits` repeats the game's catalog for reference; the game decides.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "kind",
        "mountsOn",
        "fits",
        "bounds",
        "triangles",
        "mount",
        "anchors",
        "lods"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z]+(\\.[a-z0-9-]+)+$"
        },
        "kind": {
          "const": "mod"
        },
        "mountsOn": {
          "type": "string"
        },
        "fits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bounds": {
          "$ref": "#/$defs/box"
        },
        "triangles": {
          "type": "integer"
        },
        "mount": {
          "$ref": "#/$defs/frame"
        },
        "anchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/anchor"
          }
        },
        "lods": {
          "$ref": "#/$defs/lods"
        }
      }
    },
    "locomotion": {
      "description": "How a wheel or track part rolls (v3): the axis every wheel turns about (the part's mount normal), the rolling radius at the ground, the bodies the game's mechanics turn (each a joint, its node, centre and radius), every visual wheel node that turns with them, the belt of a track, and how to drive the roll clip from a joint angle.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "axis",
        "rollingRadius",
        "bodies",
        "wheels",
        "roll",
        "shooter"
      ],
      "properties": {
        "type": {
          "enum": [
            "wheel",
            "track"
          ]
        },
        "axis": {
          "$ref": "#/$defs/vec3"
        },
        "rollingRadius": {
          "type": "number"
        },
        "bodies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "joint",
              "node",
              "centre",
              "radius"
            ],
            "properties": {
              "joint": {
                "type": "string"
              },
              "node": {
                "type": "string"
              },
              "centre": {
                "$ref": "#/$defs/vec3"
              },
              "radius": {
                "type": "number"
              }
            }
          }
        },
        "wheels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tread": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "links",
            "pitch",
            "pitchRadius",
            "outerRadius",
            "length",
            "centres",
            "metresPerRadian",
            "linksPerTurn",
            "rule"
          ],
          "properties": {
            "links": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "pitch": {
              "type": "number"
            },
            "pitchRadius": {
              "type": "number"
            },
            "outerRadius": {
              "type": "number"
            },
            "length": {
              "type": "number"
            },
            "centres": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/vec3"
              }
            },
            "metresPerRadian": {
              "type": "number"
            },
            "linksPerTurn": {
              "type": "integer"
            },
            "rule": {
              "type": "string"
            }
          }
        },
        "roll": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "animation",
            "seconds",
            "radiansPerCycle",
            "rule"
          ],
          "properties": {
            "animation": {
              "type": "string"
            },
            "seconds": {
              "type": "number"
            },
            "radiansPerCycle": {
              "type": "number"
            },
            "rule": {
              "type": "string"
            }
          }
        },
        "shooter": {
          "type": "string"
        }
      }
    }
  }
}
