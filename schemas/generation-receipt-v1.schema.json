{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moritzbrantner.github.io/asset-tooling/schemas/generation-receipt-v1.schema.json",
  "title": "asset-tooling generation receipt v1",
  "description": "Evidence emitted by a generation mutation. Exact reproducibility is established separately by rebuild verification.",
  "type": "object",
  "required": [
    "schemaVersion",
    "assetId",
    "spec",
    "tool",
    "generator",
    "randomness",
    "inputs",
    "models",
    "parametersSha256",
    "environment",
    "output",
    "reproducibility"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "assetId": { "type": "string", "minLength": 1 },
    "spec": {
      "type": "object",
      "required": ["sha256", "canonicalizer"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "canonicalizer": { "const": "asset-tooling-canonical-json-v1" }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sourceFingerprint"],
      "properties": {
        "name": { "const": "asset-tooling" },
        "version": { "type": "string", "minLength": 1 },
        "sourceFingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "sha256"],
          "properties": {
            "algorithm": { "const": "sha256-tree-v1" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "parametersSha256": { "$ref": "#/$defs/sha256" },
    "environment": {
      "type": "object",
      "required": ["schemaVersion", "platform", "runtime", "sha256"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "components": {
          "type": "array",
          "description": "Backend-specific output-affecting execution components such as GPU, driver, CUDA/ROCm/Metal runtime, numerical libraries, kernel policy, and generator runtime dependencies.",
          "items": { "type": "object" }
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "output": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "reproducibility": {
      "type": "object",
      "required": ["expected", "baseline", "reasons"],
      "properties": {
        "expected": { "enum": ["exact", "approximate"] },
        "baseline": { "enum": ["constrained", "approximate"] },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
