{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moritzbrantner.github.io/asset-tooling/schemas/asset-bundle-v5.schema.json",
  "title": "asset-tooling audio bundle v5",
  "description": "audio-wav-v1 (asset.bundle@5): canonical PCM signed-16 WAV clips (audio-asset-v1 AssetRefs) and JSON descriptors, each stored once under assets/<sha256>.<wav|json>. parseAudioBundleManifest additionally enforces unique sorted key/variant pairs, path-to-content identity and the unique payload budget; verifyAssetBundle re-hashes every file and re-checks each WAV against its canonical audio metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "assets"],
  "properties": {
    "schemaVersion": { "const": 5 },
    "profile": { "const": "audio-wav-v1" },
    "assets": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["key", "variant", "source", "path"],
        "properties": {
          "key": { "$ref": "#/$defs/token" },
          "variant": { "$ref": "#/$defs/token" },
          "source": {
            "oneOf": [
              { "$ref": "audio-asset-v1.schema.json" },
              { "$ref": "#/$defs/jsonRef" }
            ]
          },
          "path": { "type": "string", "pattern": "^assets/[0-9a-f]{64}\\.(wav|json)$" }
        }
      }
    }
  },
  "$defs": {
    "token": { "type": "string", "maxLength": 128, "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "jsonRef": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "mediaType", "sha256", "byteLength", "metadata"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "mediaType": { "const": "application/json" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 8388608 },
        "metadata": { "type": "object" }
      }
    }
  }
}
