{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moritzbrantner.github.io/asset-tooling/schemas/humanoid-item-v1.schema.json",
  "title": "asset-tooling humanoid item v1",
  "description": "The roles and named attach frames of one item that a humanoid-sockets-v2 socket can hold. Each frame is a transform in the item's glTF scene frame; a socket holding frame F places the item's scene root at socket x inverse(F). Finite values, unit quaternions and unique frame names are checked by validateHumanoidItemDescriptor.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "item", "unit", "axes", "roles", "frames"],
  "properties": {
    "schema": { "const": "humanoid-item-v1" },
    "item": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "unit": { "const": "meter" },
    "axes": { "const": "right-handed-y-up" },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/frame" }
    }
  },
  "$defs": {
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "translation", "rotation"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
        "translation": { "type": "array", "items": { "type": "number", "minimum": -10, "maximum": 10 }, "minItems": 3, "maxItems": 3 },
        "rotation": {
          "description": "Unit quaternion (x, y, z, w).",
          "type": "array", "items": { "type": "number", "minimum": -1, "maximum": 1 }, "minItems": 4, "maxItems": 4
        },
        "scale": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }, "minItems": 3, "maxItems": 3 }
      }
    }
  }
}
