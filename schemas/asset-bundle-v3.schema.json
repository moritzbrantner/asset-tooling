{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moritzbrantner.github.io/asset-tooling/schemas/asset-bundle-v3.schema.json",
  "title": "asset-tooling approved PNG bundle v3",
  "description": "Approval is the exact sha256 named in the export selection (Atlas Decision 4.1.3). Each entry's approved.sha256 must equal source.sha256; parseApprovedImageBundleManifest enforces that, unique sorted key/variant pairs and the unique payload budget.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "assets"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "profile": { "const": "approved-png-v1" },
    "assets": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["key", "variant", "approved", "source", "path"],
        "properties": {
          "key": { "$ref": "#/$defs/token" },
          "variant": { "$ref": "#/$defs/token" },
          "approved": {
            "type": "object", "additionalProperties": false,
            "required": ["sha256"],
            "properties": { "sha256": { "$ref": "#/$defs/sha256" } }
          },
          "source": { "$ref": "#/$defs/pngRef" },
          "path": { "type": "string", "pattern": "^assets/[0-9a-f]{64}\\.png$" }
        }
      }
    }
  },
  "$defs": {
    "token": { "type": "string", "maxLength": 128, "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "pngRef": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "mediaType", "sha256", "byteLength", "metadata"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "image" },
        "mediaType": { "const": "image/png" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "metadata": { "type": "object" }
      }
    }
  }
}
