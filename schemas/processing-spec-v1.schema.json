{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moritzbrantner.github.io/asset-tooling/schemas/processing-spec-v1.schema.json",
  "title": "asset-tooling processing spec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "assetId",
    "processor",
    "input",
    "parameters",
    "output",
    "reproducibility"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "assetId": { "type": "string", "minLength": 1 },
    "processor": { "$ref": "#/$defs/processor" },
    "input": { "$ref": "#/$defs/inputArtifact" },
    "parameters": { "type": "object" },
    "output": { "$ref": "#/$defs/outputArtifact" },
    "reproducibility": { "$ref": "#/$defs/reproducibility" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//).+$"
    },
    "processor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "inputArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "mediaType"],
      "properties": {
        "path": { "$ref": "#/$defs/portablePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mediaType": { "type": "string", "minLength": 1 }
      }
    },
    "outputArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mediaType"],
      "properties": {
        "path": { "$ref": "#/$defs/portablePath" },
        "mediaType": { "type": "string", "minLength": 1 }
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected"],
      "properties": {
        "expected": { "enum": ["exact", "approximate"] }
      }
    }
  }
}
