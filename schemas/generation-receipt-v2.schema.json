{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moritzbrantner.github.io/asset-tooling/schemas/generation-receipt-v2.schema.json",
  "title": "asset-tooling generation receipt v2",
  "description": "Traceable evidence shared by procedural, model-backed, and utility generation backends. Published v1 receipts remain valid against v1; v2 adds explicit backend kind, normalized parameters, and deterministic backend observations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "assetId",
    "spec",
    "tool",
    "generator",
    "randomness",
    "inputs",
    "models",
    "parameters",
    "parametersSha256",
    "observations",
    "environment",
    "output",
    "reproducibility"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "assetId": { "type": "string", "minLength": 1 },
    "spec": { "$ref": "#/$defs/specIdentity" },
    "tool": { "$ref": "#/$defs/toolIdentity" },
    "generator": { "$ref": "#/$defs/generator" },
    "randomness": { "$ref": "#/$defs/randomness" },
    "inputs": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/artifact" }
    },
    "models": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/model" }
    },
    "parameters": { "type": "object" },
    "parametersSha256": { "$ref": "#/$defs/sha256" },
    "observations": {
      "type": "object",
      "description": "Deterministic backend-reported evidence. Timing, host names, absolute paths, and other ambient/non-replay-stable values do not belong here."
    },
    "environment": { "$ref": "#/$defs/environment" },
    "output": { "$ref": "#/$defs/output" },
    "reproducibility": { "$ref": "#/$defs/reproducibility" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//).+$"
    },
    "specIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "canonicalizer"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "canonicalizer": { "const": "asset-tooling-canonical-json-v1" }
      }
    },
    "toolIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sourceFingerprint"],
      "properties": {
        "name": { "const": "asset-tooling" },
        "version": { "type": "string", "minLength": 1 },
        "sourceFingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "sha256"],
          "properties": {
            "algorithm": { "const": "sha256-tree-v1" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["procedural", "model", "utility"] }
      }
    },
    "randomness": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "none" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "seed"],
          "properties": {
            "mode": { "const": "seeded" },
            "seed": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/portablePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/portablePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "platform", "runtime", "components", "sha256"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["os", "arch"],
          "properties": {
            "os": { "type": "string", "minLength": 1 },
            "arch": { "type": "string", "minLength": 1 }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "executableSha256"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "executableSha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "components": {
          "type": "array",
          "items": { "type": "object" }
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/portablePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "baseline", "reasons"],
      "properties": {
        "expected": { "enum": ["exact", "approximate"] },
        "baseline": { "enum": ["constrained", "approximate"] },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
