{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moritzbrantner.github.io/asset-tooling/schemas/humanoid-item-v2.schema.json",
  "title": "asset-tooling humanoid item v2",
  "description": "The roles, named attach frames and optional levels of detail (#467) of one item that a humanoid-sockets-v2 socket can hold. v2 adds lodSelection and lods to v1. Each frame is a transform in the item's glTF scene frame; a socket holding frame F places the item's scene root at socket x inverse(F). Finite values, unit quaternions and unique frame names are checked by validateHumanoidItemDescriptor.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "item", "unit", "axes", "roles", "frames"],
  "properties": {
    "schema": { "const": "humanoid-item-v2" },
    "item": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "unit": { "const": "meter" },
    "axes": { "const": "right-handed-y-up" },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/frame" }
    },
    "lodSelection": {
      "description": "How to choose among lods.levels (#467, the #457 format). Present exactly when lods is.",
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "rule", "referenceFovYDegrees"],
      "properties": {
        "metric": { "const": "projected-bounding-sphere-height-fraction" },
        "rule": { "type": "string", "minLength": 1 },
        "referenceFovYDegrees": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 180 }
      }
    },
    "lods": {
      "description": "The item entry's levels of detail: bundle variants in the same frame, nearest first. Use the first level whose minScreenSize is at most the projected bounding-sphere diameter over the viewport height; the last level's minScreenSize is 0.",
      "type": "object",
      "additionalProperties": false,
      "required": ["boundingSphere", "levels"],
      "properties": {
        "boundingSphere": {
          "type": "object",
          "additionalProperties": false,
          "required": ["center", "radius"],
          "properties": {
            "center": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
            "radius": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 100 }
          }
        },
        "levels": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["variant", "triangles", "minScreenSize", "referenceMaxDistance"],
            "properties": {
              "variant": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
              "triangles": { "type": "integer", "minimum": 1 },
              "minScreenSize": { "type": "number", "minimum": 0 },
              "referenceMaxDistance": { "type": ["number", "null"], "exclusiveMinimum": 0 }
            }
          }
        }
      }
    }
  },
  "dependentRequired": { "lods": ["lodSelection"], "lodSelection": ["lods"] },
  "$defs": {
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "translation", "rotation"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
        "translation": { "type": "array", "items": { "type": "number", "minimum": -10, "maximum": 10 }, "minItems": 3, "maxItems": 3 },
        "rotation": {
          "description": "Unit quaternion (x, y, z, w).",
          "type": "array", "items": { "type": "number", "minimum": -1, "maximum": 1 }, "minItems": 4, "maxItems": 4
        },
        "scale": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }, "minItems": 3, "maxItems": 3 }
      }
    }
  }
}
