{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moritzbrantner.github.io/asset-tooling/schemas/processing-receipt-v1.schema.json",
  "title": "Asset processing receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operation",
    "implementation",
    "input",
    "parameters",
    "output",
    "environmentFingerprint",
    "reproducibility"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "operation": {
      "enum": [
        "mesh.simplify",
        "mesh.lod_chain",
        "animation.resample",
        "animation.reduce"
      ]
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "dependencies"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "input": {
      "$ref": "#/$defs/artifact"
    },
    "parameters": {
      "type": "object"
    },
    "output": {
      "$ref": "#/$defs/artifact"
    },
    "environmentFingerprint": {
      "type": "string",
      "minLength": 1
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "enum": ["exact", "structural", "unverified"]
        },
        "repeatOutputSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "mediaType"],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
