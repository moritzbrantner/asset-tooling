{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moritzbrantner.github.io/asset-tooling/schemas/asset-bundle-v1.schema.json",
  "title": "asset-tooling selected static asset bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "assets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profile": { "const": "static-glb-png-v1" },
    "assets": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["key", "variant", "source", "path"],
        "properties": {
          "key": { "$ref": "#/$defs/token" },
          "variant": { "$ref": "#/$defs/token" },
          "source": { "$ref": "#/$defs/assetRef" },
          "path": { "type": "string", "pattern": "^assets/[0-9a-f]{64}\\.(glb|png)$" }
        }
      }
    }
  },
  "$defs": {
    "token": { "type": "string", "maxLength": 128, "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "assetRef": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "mediaType", "sha256", "byteLength", "metadata"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "enum": ["scene", "mesh", "image"] },
        "mediaType": { "enum": ["model/gltf-binary", "image/png"] },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "metadata": { "type": "object" }
      },
      "oneOf": [
        { "properties": { "kind": { "enum": ["scene", "mesh"] }, "mediaType": { "const": "model/gltf-binary" } } },
        { "properties": { "kind": { "const": "image" }, "mediaType": { "const": "image/png" } } }
      ]
    }
  }
}
