{
  "name": "asset-tooling",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./schemas/*": "./schemas/*"
  },
  "bin": {
    "asset-tooling": "./src/entry.js"
  },
  "files": [
    "src",
    "schemas",
    "adapters",
    "docs",
    "README.md"
  ],
  "scripts": {
    "test": "bun test",
    "package:check": "bun scripts/check-package-shape.js",
    "check": "bun test && bun run package:check && bun src/entry.js validate examples/copy/asset.json"
  },
  "engines": {
    "bun": "1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
