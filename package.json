{
  "name": "asset-tooling",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./operations": "./src/operations.js",
    "./operations/store": "./src/asset-store.js",
    "./operations/generation": "./src/generation-operations.js",
    "./operations/generation/procedural-image": "./src/procedural-image-operations.js",
    "./operations/generation/triposr": "./src/triposr-operation.js",
    "./operations/processing": "./src/processing-operations.js",
    "./operations/processing/animation": "./src/animation-processing-operations.js",
    "./operations/image": "./src/image-operations.js",
    "./operations/image/filters": "./src/image-filter-operations.js",
    "./operations/image/advanced": "./src/image-advanced-operations.js",
    "./operations/image/colorspace": "./src/image-colorspace-operations.js",
    "./operations/image/channels": "./src/image-channel-operations.js",
    "./operations/image/analysis": "./src/image-analysis-operations.js",
    "./image/rgba8": "./src/image-rgba8.js",
    "./image/linear-rgba8": "./src/image-linear-rgba8.js",
    "./operations/audio": "./src/audio-operations.js",
    "./operations/audio/model": "./src/audio-model-operations.js",
    "./audio": "./src/audio.js",
    "./operations/workflow": "./src/workflow-operations.js",
    "./catalog": "./src/catalog.js",
    "./catalog/storage": "./src/catalog-storage.js",
    "./schemas/*": "./schemas/*"
  },
  "bin": { "asset-tooling": "./src/entry.js" },
  "files": ["src", "schemas", "adapters", "catalog", "docs", "README.md"],
  "scripts": {
    "test": "bun test",
    "package:check": "bun scripts/check-package-shape.js",
    "catalog:check": "bun scripts/check-catalog.js",
    "catalog:pin": "bun scripts/pin-catalog-source.js",
    "catalog:acquire": "bun scripts/acquire-catalog-source.js",
    "catalog:storage:check": "bun scripts/check-catalog-storage.js",
    "catalog:storage:verify": "bun scripts/verify-catalog-storage.js",
    "catalog:lfs:promote": "bun scripts/promote-catalog-lfs-source.js",
    "check": "bun test && bun run package:check && bun run catalog:check && bun run catalog:storage:check && bun src/entry.js validate examples/copy/asset.json",
    "stability:check": "bun run check && bun scripts/check-stability.js"
  },
  "engines": { "bun": "1.4.0" },
  "packageManager": "bun@1.4.0"
}
